MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=marine_clinic_care

SESSION_SECRET=<generate-at-least-32-random-characters>

# Optional: creates one initial account when it is first used to sign in.
CLINIC_ADMIN_EMAIL=medical@sailorsmedical.com
CLINIC_ADMIN_PASSWORD=Admin@123

# Optional staff bootstrap account.
CLINIC_STAFF_EMAIL=info@sailorsmedical.com
CLINIC_STAFF_PASSWORD=Staff@1
